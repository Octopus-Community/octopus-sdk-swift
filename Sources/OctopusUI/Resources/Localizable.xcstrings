    "Profile.Edit.Bio.Placeholder" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عرّف بنفسك في كلمات قليلة! من أنت، وما الذي تأمل في الحصول عليه من المجتمع…"
