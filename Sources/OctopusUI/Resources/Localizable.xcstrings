    "Common.CancelModifications" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل أنت متأكد من أنك تريد مغادرة التحرير؟ سيتم فقدان المحتوى."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du sikker på, at du vil forlade redigeringen? Indholdet vil gå tabt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchten Sie die Bearbeitung wirklich verlassen? Nicht gespeicherte Änderungen gehen verloren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to leave this page? Content will be lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Está seguro de que desea salir de la edición? El contenido se perderá."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haluatteko varmasti poistua muokkauksesta? Sisältö menetetään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Êtes-vous sûr de vouloir quitter l'édition ? Le contenu sera perdu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या आप वाकई संपादन से बाहर जाना चाहते हैं? सामग्री खो जाएगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apakah Anda yakin ingin meninggalkan pengeditan? Konten akan hilang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È sicuro di voler uscire dalla modifica? Il contenuto andrà perso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編集を中止してもよろしいですか？内容は失われます。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adakah anda pasti mahu meninggalkan penyuntingan? Kandungan akan hilang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du sikker på at du vil forlate redigeringen? Innholdet vil gå tapt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weet u zeker dat u het bewerken wilt verlaten? Inhoud gaat verloren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy na pewno chcesz opuścić tryb edycji? Zawartość zostanie utracona."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem a certeza de que quer sair da edição ? O conteúdo será perdido."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunteți sigur că doriți să părăsiți editarea? Conținutul va fi pierdut."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы уверены, что хотите выйти из редактирования? Содержимое будет потеряно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Är du säker på att du vill lämna redigeringen? Innehållet kommer att gå förlorat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณแน่ใจหรือไม่ว่าต้องการออกจากการแก้ไข? เนื้อหาจะสูญหาย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenlemeden çıkmak istediğinize emin misiniz? İçerik kaybolacak."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có chắc chắn muốn rời khỏi chỉnh sửa không? Nội dung sẽ bị mất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您确定要退出编辑吗？内容将丢失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您確定要退出編輯嗎？內容將遺失。"
          }
        }
      }
