    "Accessibility.Post.Summary.Moderated_author:%@_date:%@_reasons:%@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ كتب %2$@ محتوى تمت مراجعته للأسباب التالية: %3$@"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ skrev %2$@ et indhold, der er blevet modereret af følgende grunde: %3$@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ schrieb %2$@ einen Inhalt, der aus folgenden Gründen moderiert wurde: %3$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wrote %2$@ a content that has been moderated for the following reasons %3$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ escribió %2$@ un contenido que fue moderado por las siguientes razones: %3$@"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kirjoitti %2$@ sisällön, joka on moderoitu seuraavista syistä: %3$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a écrit %2$@ un contenu qui a été modéré pour les raisons suivantes : %3$@"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ने %2$@ को एक सामग्री लिखी जिसकी निम्नलिखित कारणों से समीक्षा की गई है: %3$@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ menulis %2$@ konten yang telah dimoderasi karena alasan berikut: %3$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ha scritto %2$@ un contenuto che è stato moderato per i seguenti motivi: %3$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ が %2$@ に投稿したコンテンツは以下の理由でモデレートされました: %3$@"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ menulis %2$@ kandungan yang telah dimoderasi atas sebab berikut: %3$@"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ skrev %2$@ et innhold som er moderert av følgende grunner: %3$@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ schreef %2$@ inhoud die om de volgende redenen is gemodereerd: %3$@"
          }
