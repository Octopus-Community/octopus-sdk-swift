    "Connection.MagicLink.Description" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شارك، تواصل، واستلهم: انضم إلى مجتمع يفهمك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del, netværk og bliv inspireret: bliv en del af et fællesskab, der forstår dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teilen Sie, diskutieren Sie und lassen Sie sich von einer Community inspirieren, die zu Ihnen passt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share, connect, and get inspired: join a community that gets you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparta, converse e inspírese en una comunidad hecha para usted."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jakakaa, verkostoitukaa ja inspiroitukaa: liittykää yhteisöön, joka ymmärtää Teitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagez, discutez et inspirez-vous dans une communauté faite pour vous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साझा करें, जुड़ें, और प्रेरणा पाएं: एक ऐसे कम्युनिटी से जुड़ें जो आपको समझता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagikan, terhubung, dan dapatkan inspirasi: bergabunglah dengan komunitas yang memahami Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condivida, discuta e si lasci ispirare in una comunità pensata per lei."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェアして、つながり、インスピレーションを得る:あなたを理解するコミュニティに参加しましょう。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kongsi, hubung, dan dapatkan inspirasi: sertai komuniti yang memahami anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del, knytt kontakter og bli inspirert: bli en del av et fellesskap som forstår deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deel, maak contact en laat u inspireren: word deel van een community die u begrijpt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dziel się, rozmawiaj i inspiruj się w społeczności stworzonej dla Ciebie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partilhe, discuta e inspire-se numa comunidade feita para si."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Împărtășiți, conectați-vă și inspirați-vă: alăturați-vă unei comunități care vă înțelege."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Делитесь, общайтесь и вдохновляйтесь: присоединяйтесь к сообществу, которое Вас понимает."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dela, prata och inspireras i ett community som är gjort för dig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แบ่งปัน เชื่อมต่อ และรับแรงบันดาลใจ: เข้าร่วมชุมชนที่เข้าใจคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sizin için hazırlanmış bir toplulukta paylaşın, sohbet edin ve ilham alın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chia sẻ, kết nối và lấy cảm hứng: tham gia cộng đồng hiểu bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分享、连接、获取灵感：加入一个懂您的社区。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分享、連結、獲取靈感：加入一個懂您的社群。"
          }
        }
      }
    },
