    "UnsupportedOS.Explanation" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للوصول إلى ميزات المجتمع، يرجى تحديث جهاز iPhone إلى iOS 14 أو أحدث. بهذه الطريقة تحصل على أفضل تجربة، إلى جانب أحدث الميزات وتحديثات الأمان!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at få adgang til fællesskabets funktioner skal du opdatere din iPhone til iOS 14 eller nyere. Sådan får du den bedste oplevelse samt de nyeste funktioner og sikkerhedsopdateringer!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um auf die Community-Funktionen zugreifen zu können, aktualisieren Sie bitte Ihr iPhone auf iOS 14 oder höher. So profitieren Sie von den neuesten Funktionen und Sicherheitsupdates für ein optimales Nutzungserlebnis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To access the community features, please update your iPhone to iOS 14 or later. Updating ensures you get the latest features, security updates, and the best experience!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para acceder a las funciones de la comunidad, actualice su iPhone a iOS 14 o una versión posterior. Así disfrutará de la mejor experiencia, con las funciones más recientes y las últimas actualizaciones de seguridad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päästäksenne yhteisön toimintoihin päivittäkää iPhonenne iOS 14:ään tai uudempaan. Näin saatte parhaan käyttökokemuksen, uusimmat ominaisuudet ja tietoturvapäivitykset!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour accéder aux fonctionnalités communautaires, veuillez mettre à jour votre iPhone vers iOS 14 ou une version ultérieure. Cela vous garantit la meilleure expérience avec les dernières fonctionnalités et mises à jour de sécurité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कम्युनिटी की सुविधाओं तक पहुंचने के लिए, कृपया अपने iPhone को iOS 14 या नए संस्करण में अपडेट करें। इस तरह आपको सर्वश्रेष्ठ अनुभव, नवीनतम सुविधाएं और सुरक्षा अपडेट मिलेंगे!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk mengakses fitur komunitas, silakan perbarui iPhone Anda ke iOS 14 atau yang lebih baru. Dengan cara ini Anda akan mendapatkan pengalaman terbaik, fitur terbaru, dan pembaruan keamanan!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per accedere alle funzionalità della comunità, aggiorni il suo iPhone a iOS 14 o versioni successive. In questo modo usufruirà della migliore esperienza, con le funzionalità più recenti e gli ultimi aggiornamenti di sicurezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コミュニティ機能をご利用いただくには、お使いの iPhone を iOS 14 以降にアップデートしてください。最高の体験、最新機能、セキュリティアップデートをお楽しみいただけます!"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk mengakses ciri komuniti, sila kemas kini iPhone anda ke iOS 14 atau versi yang lebih baharu. Dengan cara ini anda akan mendapat pengalaman terbaik, ciri terkini, dan kemas kini keselamatan!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å få tilgang til fellesskapsfunksjonene må du oppdatere iPhonen din til iOS 14 eller nyere. Slik får du den beste opplevelsen, samt de nyeste funksjonene og sikkerhetsoppdateringene!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werk uw iPhone bij naar iOS 14 of nieuwer om toegang te krijgen tot de community-functies. Zo krijgt u de beste ervaring en de nieuwste functies en beveiligingsupdates!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby uzyskać dostęp do funkcji społeczności, zaktualizuj iPhone’a do iOS 14 lub nowszej wersji. Zapewni to najlepsze wrażenia oraz dostęp do najnowszych funkcji i aktualizacji zabezpieczeń."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para aceder às funcionalidades da comunidade, atualize o seu iPhone para o iOS 14 ou uma versão posterior. Isto garante-lhe a melhor experiência com as funcionalidades mais recentes e com as últimas atualizações de segurança."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru a accesa funcționalitățile comunității, actualizați iPhone-ul dumneavoastră la iOS 14 sau o versiune mai nouă. Astfel beneficiați de cea mai bună experiență, precum și de cele mai noi funcționalități și actualizări de securitate!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для доступа к функциям сообщества, пожалуйста, обновите Ваш iPhone до iOS 14 или новее. Так Вы получите лучший опыт, новейшие функции и обновления безопасности!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att få tillgång till communityfunktionerna behöver du uppdatera din iPhone till iOS 14 eller senare. Det ger dig den bästa upplevelsen samt de senaste funktionerna och säkerhetsuppdateringarna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพื่อเข้าถึงคุณสมบัติของชุมชน กรุณาอัปเดต iPhone ของคุณเป็น iOS 14 หรือเวอร์ชั่นใหม่กว่า วิธีนี้จะทำให้คุณได้รับประสบการณ์ที่ดีที่สุด พร้อมคุณสมบัติล่าสุดและการอัปเดตด้านความปลอดภัย!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topluluk özelliklerine erişmek için lütfen iPhone'unuzu iOS 14 veya daha yeni bir sürüme güncelleyin. Böylece en iyi deneyimi, en yeni özellikleri ve güvenlik güncellemelerini elde edersiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để truy cập các tính năng cộng đồng, vui lòng cập nhật iPhone của bạn lên iOS 14 hoặc mới hơn. Bằng cách này, bạn sẽ có được trải nghiệm tốt nhất cùng các tính năng mới nhất và cập nhật bảo mật!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要访问社区功能，请将您的 iPhone 更新到 iOS 14 或更高版本。这样您将获得最佳体验、最新功能和安全更新！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要使用社群功能，請將您的 iPhone 更新至 iOS 14 或更新版本。這樣您將獲得最佳體驗、最新功能和安全性更新！"
          }
        }
      }
    },
