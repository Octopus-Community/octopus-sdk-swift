    "Settings.Profile.DeleteAccount.Reason.CommunityQuality" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محتوى المجتمع أو الإدارة لا يلبيان توقعاتي."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fællesskabets indhold eller moderation lever ikke op til mine forventninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich bin mit der Moderation oder dem Inhalt der Community nicht zufrieden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The community's content and moderation don’t feel right for me."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No estoy satisfecho/a con la moderación o la calidad de la comunidad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhteisön sisältö tai moderointi ei vastaa odotuksiani."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je ne suis pas satisfait(e) de la modération ou de la qualité de la communauté"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कम्युनिटी की सामग्री या मॉडरेशन मेरी उम्मीदों पर खरा नहीं उतरता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konten atau moderasi komunitas tidak sesuai dengan harapan saya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non sono soddisfatto della moderazione o della qualità della comunità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コミュニティのコンテンツやモデレーションが期待に応えていません。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kandungan atau moderasi komuniti tidak menepati jangkaan saya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innholdet eller modereringen i fellesskapet svarer ikke til mine forventninger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De inhoud of moderatie van de community voldoet niet aan mijn verwachtingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie jestem zadowolony(-a) z jakości treści lub moderacji społeczności."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não estou satisfeito(a) com a moderação ou com a qualidade da comunidade"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conținutul sau moderarea comunității nu corespund așteptărilor mele."
          }
