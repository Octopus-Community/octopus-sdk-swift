    "Connection.SSO.Error.Unknown" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نحاول استرداد بياناتك. يرجى المحاولة مرة أخرى بعد لحظات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi forsøger at hente dine data. Prøv igen om et øjeblik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir versuchen, Ihre Daten abzurufen. Bitte haben Sie einen Moment Geduld."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We are trying to retrieve your data. Please try again in a few moments."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estamos intentando recuperar sus datos. Vuelva a intentarlo dentro de unos instantes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yritämme noutaa tietojanne. Yrittäkää uudelleen hetken kuluttua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous tentons de récupérer vos données. Veuillez réessayer dans quelques instants."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हम आपका डेटा प्राप्त करने की कोशिश कर रहे हैं। कृपया कुछ ही क्षणों में फिर से कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami sedang mencoba mengambil data Anda. Silakan coba lagi dalam beberapa saat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stiamo cercando di recuperare i suoi dati. Riprovi tra qualche istante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データを取得しています。しばらくしてからもう一度お試しください。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami sedang cuba mendapatkan semula data anda. Sila cuba lagi sebentar lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi prøver å hente dataene dine. Prøv igjen om et øyeblikk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We proberen uw gegevens op te halen. Probeer het over enkele ogenblikken opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Próbujemy pobrać Twoje dane. Spróbuj ponownie za chwilę."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estamos a tentar recuperar os seus dados. Tente novamente dentro de alguns instantes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
