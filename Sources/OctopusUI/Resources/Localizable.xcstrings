    "Settings.Profile.DeleteAccount.Confirmation.Message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا حذفت حسابك، فلن تتمكن من المشاركة في المجتمع. سيتم حذف ملفك الشخصي بشكل دائم، وستُجعل منشوراتك مجهولة الهوية. لا يمكن التراجع عن هذا الإجراء. هل تريد المتابعة؟"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved at slette din konto vil du ikke længere kunne deltage i fællesskabet. Din profil bliver slettet permanent, og dine opslag bliver anonymiseret. Denne handling kan ikke fortrydes. Vil du fortsætte?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie Ihr Konto löschen, können Sie nicht mehr an der Community teilnehmen. Ihr Profil wird dauerhaft gelöscht, und Ihre Beiträge werden anonymisiert. Diese Aktion ist unwiderruflich. Möchten Sie fortfahren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By deleting your account, you will no longer be able to participate in the community. Your profile will be permanently deleted, and your posts will be anonymized. This action is irreversible. Do you wish to proceed?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si elimina su cuenta, ya no podrá participar en la comunidad. Su perfil se eliminará de forma permanente y sus publicaciones se anonimizarán. Esta acción es irreversible. ¿Desea continuar?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos poistatte tilinne, ette voi enää osallistua yhteisöön. Profiilinne poistetaan pysyvästi ja julkaisunne anonymisoidaan. Tätä toimintoa ei voi peruuttaa. Haluatteko jatkaa?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En supprimant votre compte, vous ne pourrez plus participer à la communauté. Votre profil sera définitivement supprimé et vos publications seront anonymisées. Cette action est irréversible. Souhaitez-vous continuer ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यदि आप अपना खाता हटाते हैं, तो आप कम्युनिटी में भाग नहीं ले पाएंगे। आपकी प्रोफ़ाइल स्थायी रूप से हटा दी जाएगी, और आपकी पोस्ट गुमनाम कर दी जाएंगी। यह क्रिया अपरिवर्तनीय है। क्या आप जारी रखना चाहते हैं?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika Anda menghapus akun Anda, Anda tidak akan dapat berpartisipasi dalam komunitas lagi. Profil Anda akan dihapus secara permanen, dan postingan Anda akan dianonimkan. Tindakan ini tidak dapat dibatalkan. Apakah Anda ingin melanjutkan?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminando il suo account non potrà più partecipare alla comunità. Il suo profilo sarà eliminato definitivamente e le sue pubblicazioni saranno anonimizzate. Questa azione è irreversibile. Desidera continuare?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントを削除すると、コミュニティに参加できなくなります。プロフィールは永久に削除され、投稿は匿名化されます。この操作は元に戻せません。続行しますか?"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika anda memadam akaun anda, anda tidak akan dapat menyertai komuniti lagi. Profil anda akan dipadam secara kekal, dan hantaran anda akan dijadikan tanpa nama. Tindakan ini tidak boleh dibatalkan. Adakah anda mahu teruskan?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du sletter kontoen din, kan du ikke lenger delta i fellesskapet. Profilen din slettes permanent, og innleggene dine anonymiseres. Denne handlingen kan ikke angres. Vil du fortsette?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als u uw account verwijdert, kunt u niet meer deelnemen aan de community. Uw profiel wordt permanent verwijderd en uw berichten worden geanonimiseerd. Deze actie is onomkeerbaar. Wilt u doorgaan?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwając konto, nie będziesz mógł/mogła dalej uczestniczyć w społeczności. Twój profil zostanie trwale usunięty, a publikacje zanonimizowane. Ta operacja jest nieodwracalna. Czy chcesz kontynuować?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao eliminar a sua conta, deixará de poder participar na comunidade. O seu perfil será eliminado definitivamente e as suas publicações serão anonimizadas. Esta ação é irreversível. Pretende continuar ?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă vă ștergeți contul, nu veți mai putea participa la comunitate. Profilul dumneavoastră va fi șters permanent, iar postările dumneavoastră vor fi anonimizate. Această acțiune este ireversibilă. Doriți să continuați?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если Вы удалите Ваш аккаунт, Вы больше не сможете участвовать в сообществе. Ваш профиль будет удалён навсегда, а Ваши посты станут анонимными. Это действие необратимо. Вы хотите продолжить?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du tar bort ditt konto kommer du inte längre att kunna delta i communityt. Din profil tas bort permanent och dina inlägg anonymiseras. Den här åtgärden kan inte ångras. Vill du fortsätta?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากคุณลบบัญชีของคุณ คุณจะไม่สามารถเข้าร่วมชุมชนได้อีกต่อไป โปรไฟล์ของคุณจะถูกลบอย่างถาวร และโพสต์ของคุณจะถูกทำให้ไม่ระบุตัวตน การกระทำนี้ไม่สามารถยกเลิกได้ ต้องการดำเนินการต่อหรือไม่?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesabınızı silerseniz artık topluluğa katılamazsınız. Profiliniz kalıcı olarak silinecek ve gönderileriniz anonim hâle getirilecektir. Bu işlem geri alınamaz. Devam etmek istiyor musunuz?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bạn xóa tài khoản của mình, bạn sẽ không thể tham gia cộng đồng nữa. Hồ sơ của bạn sẽ bị xóa vĩnh viễn và các bài đăng của bạn sẽ được ẩn danh. Hành động này không thể hoàn tác. Bạn có muốn tiếp tục không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您删除账户，您将无法再参与社区。您的个人资料将被永久删除，您的帖子将被匿名化。此操作不可逆。是否继续？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您刪除帳號，您將無法再參與社群。您的個人檔案將被永久刪除，您的貼文將被匿名化。此操作不可逆。是否繼續？"
          }
        }
      }
    },
