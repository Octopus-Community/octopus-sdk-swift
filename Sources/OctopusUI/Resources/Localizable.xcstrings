    "Content.Create.Legal_termOfUse:%@_privacyPolicy:%@_communityGuidelines:%@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من خلال نشر رسالتي، أوافق على [شروط الاستخدام](%1$@) و[سياسة الخصوصية](%2$@) و[إرشادات المجتمع](%3$@)"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved at udgive min besked accepterer jeg [Brugsvilkårene](%1$@), [Privatlivspolitikken](%2$@) og [Fællesskabets retningslinjer](%3$@)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Veröffentlichen meiner Nachricht akzeptiere ich die [Nutzungsbedingungen](%1$@), die [Datenschutzrichtlinie](%2$@) und die [Community-Regeln](%3$@)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By posting my message, I accept the [Terms of Use](%1$@), [Privacy Policy](%2$@), and [Community Guidelines](%3$@)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al publicar mi mensaje, acepto las [Condiciones Generales de Uso](%1$@), la [Política de privacidad](%2$@) y las [Normas de la comunidad](%3$@)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Julkaisemalla viestini hyväksyn [Käyttöehdot](%1$@), [Tietosuojakäytännön](%2$@) ja [Yhteisön säännöt](%3$@)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En publiant mon message, j’accepte les [CGUs](%1$@), la [politique de confidentialité](%2$@) et les [règles de la communauté](%3$@)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना संदेश पोस्ट करके, मैं [उपयोग की शर्तें](%1$@), [गोपनीयता नीति](%2$@), और [कम्युनिटी दिशानिर्देश](%3$@) स्वीकार करता हूं"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan memposting pesan saya, saya menerima [Syarat penggunaan](%1$@), [Kebijakan privasi](%2$@), dan [Pedoman komunitas](%3$@)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pubblicando il mio messaggio, accetto i [Termini di utilizzo](%1$@), l'[informativa sulla privacy](%2$@) e le [regole della community](%3$@)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージを投稿することで、[利用規約](%1$@)、[プライバシーポリシー](%2$@)、[コミュニティガイドライン](%3$@)に同意します"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan menghantar mesej saya, saya menerima [Syarat Penggunaan](%1$@), [Dasar Privasi](%2$@), dan [Garis panduan komuniti](%3$@)"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved å publisere meldingen min godtar jeg [Brukervilkårene](%1$@), [Personvernerklæringen](%2$@) og [Retningslinjene for fellesskapet](%3$@)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Door mijn bericht te plaatsen, accepteer ik de [Gebruiksvoorwaarden](%1$@), het [Privacybeleid](%2$@) en de [Community-richtlijnen](%3$@)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Publikując wiadomość, akceptuję [Regulamin](%1$@), [Politykę prywatności](%2$@) oraz [Zasady społeczności](%3$@)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao publicar a minha mensagem, aceito os [Termos de Uso](%1$@), a [Política de Privacidade](%2$@) e as [Regras da Comunidade](%3$@)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prin publicarea mesajului meu, accept [Termenii de utilizare](%1$@), [Politica de confidențialitate](%2$@) și [Regulile comunității](%3$@)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Публикуя моё сообщение, я принимаю [Условия использования](%1$@), [Политику конфиденциальности](%2$@) и [Правила сообщества](%3$@)"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genom att publicera mitt inlägg godkänner jag [Användarvillkoren](%1$@), [Integritetspolicyn](%2$@) och [Communityreglerna](%3$@)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ด้วยการโพสต์ข้อความของฉัน ฉันยอมรับ [ข้อกำหนดการใช้งาน](%1$@) [นโยบายความเป็นส่วนตัว](%2$@) และ [แนวทางปฏิบัติของชุมชน](%3$@)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesajımı paylaşarak [Kullanım koşulları](%1$@), [Gizlilik politikası](%2$@) ve [Topluluk kuralları](%3$@) hükümlerini kabul ediyorum."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bằng cách đăng tin nhắn của tôi, tôi chấp nhận [Điều khoản sử dụng](%1$@), [Chính sách bảo mật](%2$@), và [Quy tắc cộng đồng](%3$@)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发布消息即表示我接受 [使用条款](%1$@)、[隐私政策](%2$@) 和 [社区准则](%3$@)"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "發布訊息即表示我接受 [使用條款](%1$@)、[隱私政策](%2$@) 和 [社群準則](%3$@)"
          }
        }
      }
    },
