    "Block.Profile.Alert.Message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا حظرت هذا المستخدم، فلن تتمكن من رؤية رسائله أو ملفه الشخصي بعد الآن. هل تريد المتابعة؟"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du blokerer denne bruger, kan du ikke længere se vedkommendes beskeder eller profil. Vil du fortsætte?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie diesen Nutzer blockieren, können Sie seine Nachrichten oder sein Profil nicht mehr sehen. Möchten Sie fortfahren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By blocking this user, you will no longer be able to see their messages or profile. Do you want to continue?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si bloquea a este usuario, ya no podrá ver sus mensajes ni su perfil. ¿Desea continuar?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos estätte tämän käyttäjän, ette enää näe hänen viestejään tai profiiliaan. Haluatteko jatkaa?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En bloquant cet utilisateur, vous ne pourrez plus voir ses messages ou son profil. Souhaitez-vous continuer ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यदि आप इस उपयोगकर्ता को ब्लॉक करते हैं, तो आप उनके संदेश या प्रोफ़ाइल नहीं देख पाएंगे। क्या आप जारी रखना चाहते हैं?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika Anda memblokir pengguna ini, Anda tidak akan dapat melihat pesan atau profil mereka lagi. Apakah Anda ingin melanjutkan?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloccando questo utente non potrà più vedere i suoi messaggi o il suo profilo. Desidera continuare?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このユーザーをブロックすると、メッセージやプロフィールが表示されなくなります。続行しますか？"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika anda menyekat pengguna ini, anda tidak akan dapat melihat mesej atau profil mereka lagi. Adakah anda mahu teruskan?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du blokkerer denne brukeren, kan du ikke lenger se meldingene eller profilen deres. Vil du fortsette?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als u deze gebruiker blokkeert, kunt u hun berichten of profiel niet meer zien. Wilt u doorgaan?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po zablokowaniu tego użytkownika nie będziesz już widzieć jego wiadomości ani otrzymywać jego powiadomień."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao bloquear este utilizador, deixará de ver as mensagens e o perfil dele. Pretende continuar ?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă blocați acest utilizator, nu îi veți mai putea vedea mesajele sau profilul. Doriți să continuați?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если Вы заблокируете этого пользователя, Вы больше не сможете видеть его сообщения или профиль. Вы хотите продолжить?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du blockerar den här användaren kommer du inte längre att se deras meddelanden eller få deras aviseringar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากคุณบล็อกผู้ใช้รายนี้ คุณจะไม่สามารถเห็นข้อความหรือโปรไฟล์ของผู้ใช้รายนี้ได้อีกต่อไป ต้องการดำเนินการต่อหรือไม่?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kullanıcıyı engellerseniz mesajlarını ve profilini artık göremeyeceksiniz. Devam etmek istiyor musunuz?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bạn chặn người dùng này, bạn sẽ không thể xem tin nhắn hoặc hồ sơ của họ nữa. Bạn có muốn tiếp tục không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屏蔽此用户后，您将无法再查看其消息或个人资料。是否继续？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "封鎖此使用者後，您將無法再查看其訊息或個人檔案。是否繼續？"
          }
        }
      }
    },
