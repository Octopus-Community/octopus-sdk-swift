    "Picture.Selection.Error_maxRatio:%@_minSize:%lld" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصورة المختارة غير صالحة. يرجى اختيار صورة بنسبة أبعاد %1$@ كحد أقصى ودقة لا تقل عن %2$lld بكسل."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det valgte billede er ikke gyldigt. Vælg et billede med et maksimalt billedformat på %1$@ og en opløsning på mindst %2$lld pixels."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ausgewählte Bild ist ungültig. Bitte wählen Sie ein Bild mit einem maximalen Seitenverhältnis von %1$@ und einer Auflösung von mindestens %2$lld Pixeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected picture is not valid. Please chose an image with a maximum ratio of %1$@ and a resolution of at least %2$lld pixels."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La foto seleccionada no es válida. Elija una imagen con una proporción máxima de %1$@ y una resolución de al menos %2$lld píxeles."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valittu kuva ei kelpaa. Valitkaa kuva, jonka kuvasuhde on enintään %1$@ ja resoluutio vähintään %2$lld pikseliä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La photo sélectionnée n'est pas conforme. Veuillez choisir une image avec un ratio maximum de %1$@ et une résolution d'au moins %2$lld pixels."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनी गई तस्वीर मान्य नहीं है। कृपया अधिकतम अनुपात %1$@ और कम से कम %2$lld पिक्सेल रिज़ॉल्यूशन वाली तस्वीर चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gambar yang dipilih tidak valid. Silakan pilih gambar dengan rasio maksimum %1$@ dan resolusi minimal %2$lld piksel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La foto selezionata non è valida. Scelga un'immagine con un rapporto massimo di %1$@ e una risoluzione di almeno %2$lld pixel."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択された画像は無効です。アスペクト比 %1$@ 以下、解像度 %2$lld ピクセル以上の画像を選択してください。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gambar yang dipilih tidak sah. Sila pilih imej dengan nisbah maksimum %1$@ dan resolusi sekurang-kurangnya %2$lld piksel."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det valgte bildet er ikke gyldig. Velg et bilde med maksimalt bildeforhold på %1$@ og en oppløsning på minst %2$lld piksler."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De geselecteerde afbeelding is niet geldig. Kies een afbeelding met een maximale verhouding van %1$@ en een resolutie van minstens %2$lld pixels."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybrane zdjęcie jest nieprawidłowe. Wybierz obraz o maksymalnych proporcjach %1$@ i rozdzielczości co najmniej %2$lld pikseli."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A foto selecionada não é válida. Escolha uma imagem com uma proporção máxima de %1$@ e uma resolução de pelo menos %2$lld píxeis."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imaginea selectată nu este validă. Alegeți o imagine cu un raport maxim de %1$@ și o rezoluție de cel puțin %2$lld pixeli."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбранное изображение недопустимо. Пожалуйста, выберите изображение с максимальным соотношением %1$@ и разрешением не менее %2$lld пикселей."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den valda bilden är ogiltig. Välj en bild med ett maximalt bildförhållande på %1$@ och en upplösning på minst %2$lld pixlar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รูปภาพที่เลือกไม่ถูกต้อง กรุณาเลือกรูปภาพที่มีอัตราส่วนสูงสุด %1$@ และความละเอียดอย่างน้อย %2$lld พิกเซล"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçilen fotoğraf geçerli değil. Lütfen en fazla %1$@ oranına ve en az %2$lld piksel çözünürlüğe sahip bir görsel seçin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ảnh được chọn không hợp lệ. Vui lòng chọn một hình ảnh với tỷ lệ tối đa %1$@ và độ phân giải ít nhất %2$lld pixel."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选图片无效。请选择宽高比最大为 %1$@、分辨率至少 %2$lld 像素的图片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所選圖片無效。請選擇寬高比最大為 %1$@、解析度至少 %2$lld 像素的圖片。"
          }
        }
      }
    },
