          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presenter deg selv med få ord! Hvem er du, og hva håper du å få ut av fellesskapet…"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
