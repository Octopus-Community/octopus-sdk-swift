    "Moderation.Common.Done.Message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شكرًا، لقد تم استلام بلاغك وسيتم التعامل معه من قبل فريقنا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak, din anmeldelse er modtaget og bliver behandlet af vores team."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danke, Ihre Meldung wurde berücksichtigt und an die Moderation weitergeleitet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thank you, your report has been received and will be handled by our team."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gracias, hemos recibido su denuncia y nuestro equipo la revisará."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiitos, ilmoituksenne on vastaanotettu ja tiimimme käsittelee sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merci, votre signalement a été pris en compte et sera traité par notre équipe."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "धन्यवाद, आपकी रिपोर्ट प्राप्त हो गई है और हमारी टीम द्वारा संभाली जाएगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terima kasih, laporan Anda telah diterima dan akan ditangani oleh tim kami."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grazie, la sua segnalazione è stata ricevuta e sarà esaminata dal nostro team."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ありがとうございます。報告を受け付けました。チームが対応いたします。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terima kasih, laporan anda telah diterima dan akan dikendalikan oleh pasukan kami."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takk, rapporten din er mottatt og blir behandlet av teamet vårt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedankt, uw melding is ontvangen en wordt afgehandeld door ons team."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dziękujemy, Twoje zgłoszenie zostało przyjęte i zostanie rozpatrzone przez nasz zespół."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrigado, a sua denúncia foi recebida e será analisada pela nossa equipa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulțumim, raportarea dumneavoastră a fost primită și va fi gestionată de echipa noastră."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спасибо, Ваша жалоба получена и будет обработана нашей командой."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tack, din anmälan har tagits emot och kommer att hanteras av vårt team."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขอบคุณ การรายงานของคุณได้รับการรับเรียบร้อยแล้ว และทีมของเราจะดำเนินการต่อไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teşekkürler, bildiriminiz alınmıştır ve ekibimiz tarafından incelenecektir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cảm ơn, báo cáo của bạn đã được tiếp nhận và sẽ được đội ngũ của chúng tôi xử lý."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "谢谢，您的举报已收到，将由我们的团队处理。"
