    "Settings.Profile.DeleteAccount.Farewell" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نأسف لرحيلك. نود أن نفهم لماذا تريد حذف حسابك:"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er ærgerligt at se dig forsvinde. Vi vil gerne forstå, hvorfor du vil slette din konto:"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es tut uns leid, Sie gehen zu sehen. Wir würden gerne wissen, warum Sie Ihr Konto löschen möchten:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We’re sorry to see you go. We’d like to understand why you want to delete your account:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentimos que se marche. Nos gustaría saber por qué desea eliminar su cuenta:"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On ikävä nähdä Teidän lähtevän. Haluaisimme tietää, miksi haluatte poistaa tilinne:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous sommes désolés de vous voir partir. Nous aimerions savoir pourquoi vous souhaitez supprimer votre compte :"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हमें आपके जाने का दुख है। हम समझना चाहेंगे कि आप अपना खाता क्यों हटाना चाहते हैं:"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami sedih melihat Anda pergi. Kami ingin memahami mengapa Anda ingin menghapus akun Anda:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ci dispiace vederla andare via. Vorremmo sapere perché desidera eliminare il suo account:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ご退会されるのは残念です。アカウントを削除したい理由をお聞かせいただけますか:"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami sedih melihat anda pergi. Kami ingin memahami mengapa anda mahu memadam akaun anda:"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er trist å se deg dra. Vi vil gjerne forstå hvorfor du vil slette kontoen din:"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We vinden het jammer dat u vertrekt. We willen graag weten waarom u uw account wilt verwijderen:"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przykro nam, że odchodzisz. Chcielibyśmy zrozumieć, dlaczego chcesz usunąć konto:"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lamentamos que queira sair. Gostaríamos de saber porque pretende eliminar a sua conta :"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne pare rău să vă vedem plecând. Am dori să înțelegem de ce doriți să vă ștergeți contul:"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нам жаль, что Вы уходите. Мы хотели бы понять, почему Вы хотите удалить Ваш аккаунт:"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tråkigt att se dig lämna. Vi vill gärna förstå varför du vill ta bort ditt konto:"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เราเสียใจที่เห็นคุณจากไป เราอยากเข้าใจว่าทำไมคุณจึงต้องการลบบัญชีของคุณ:"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayrılmanıza üzüldük. Hesabınızı neden silmek istediğinizi bilmek isteriz:"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chúng tôi tiếc khi thấy bạn rời đi. Chúng tôi muốn hiểu lý do tại sao bạn muốn xóa tài khoản của mình:"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很遗憾看到您离开。我们想了解您为什么要删除账户："
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很遺憾看到您離開。我們想了解您為什麼要刪除帳號："
          }
        }
      }
    },
