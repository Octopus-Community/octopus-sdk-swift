    "Settings.Profile.DeleteAccount.Done.Message_contactEmail:%@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت معالجة طلب حذف حسابك. لم يعد لديك إمكانية الوصول إلى حسابك. لأي أسئلة، تواصل معنا على %@"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din sletningsanmodning er blevet behandlet. Du har ikke længere adgang til din konto. Har du spørgsmål, kontakt os på %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Löschanfrage wurde erfolgreich entgegengenommen. Sie haben keinen Zugriff mehr auf Ihr Konto. Bei Fragen kontaktieren Sie uns bitte unter %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your deletion request has been successfully processed. You no longer have access to your account. If you have any questions, please contact us at %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu solicitud de eliminación se ha tenido en cuenta. Ya no tienes acceso a tu cuenta. Si tienes alguna pregunta, contáctanos en %@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistopyyntönne on käsitelty. Teillä ei ole enää pääsyä tilillenne. Jos Teillä on kysymyksiä, ottakaa yhteyttä osoitteeseen %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre demande de suppression a bien été prise en compte. Vous n'avez plus accès à votre compte. En cas de question, veuillez nous contacter à %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका खाता हटाने का अनुरोध संसाधित हो गया है। अब आपके पास अपने खाते तक पहुंच नहीं है। किसी भी प्रश्न के लिए, हमसे %@ पर संपर्क करें"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permintaan penghapusan Anda telah diproses. Anda tidak lagi memiliki akses ke akun Anda. Jika ada pertanyaan, silakan hubungi kami di %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sua richiesta di eliminazione è stata presa in carico. Non ha più accesso al suo account. In caso di domande, ci contatti a %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除リクエストを処理しました。アカウントへのアクセスはできなくなりました。ご質問がある場合は %@ までお問い合わせください"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permintaan pemadaman anda telah diproses. Anda tidak lagi mempunyai akses kepada akaun anda. Jika ada pertanyaan, sila hubungi kami di %@"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sletteforespørselen din er behandlet. Du har ikke lenger tilgang til kontoen din. Ved spørsmål, kontakt oss på %@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uw verwijderingsverzoek is verwerkt. U hebt geen toegang meer tot uw account. Bij vragen kunt u contact met ons opnemen via %@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja prośba o usunięcie konta została przyjęta. Nie masz już dostępu do swojego konta. W razie pytań skontaktuj się z nami pod adresem %@."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu pedido de eliminação foi registado. Já não tem acesso à sua conta. Em caso de dúvida, contacte-nos para %@."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitarea dumneavoastră de ștergere a fost procesată. Nu mai aveți acces la contul dumneavoastră. Pentru întrebări, contactați-ne la %@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш запрос на удаление обработан. У Вас больше нет доступа к Вашему аккаунту. По любым вопросам, пожалуйста, свяжитесь с нами по адресу %@"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din begäran om borttagning har behandlats. Du har inte längre tillgång till ditt konto. Vid frågor, kontakta oss på %@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำขอลบบัญชีของคุณได้รับการดำเนินการแล้ว คุณไม่สามารถเข้าถึงบัญชีของคุณได้อีกต่อไป หากมีคำถาม กรุณาติดต่อเราที่ %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silme talebiniz başarıyla alındı. Artık hesabınıza erişiminiz yok. Sorularınız olursa lütfen %@ adresinden bizimle iletişime geçin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yêu cầu xóa của bạn đã được xử lý. Bạn không còn quyền truy cập vào tài khoản của mình. Nếu có thắc mắc, vui lòng liên hệ với chúng tôi tại %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的删除请求已处理。您将无法再访问您的账户。如有疑问，请通过 %@ 联系我们"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的刪除請求已處理。您將無法再存取您的帳號。如有疑問，請透過 %@ 聯絡我們"
          }
        }
      }
    },
