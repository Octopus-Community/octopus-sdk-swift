// To run the Sample, this file should be copied and renamed secrets.xcconfig.
// Then, you should:
// - replace "YOUR_API_KEY" with your actual API key.
// - replace "CLIENT_USER_TOKEN_SECRET" with your client secret.
//
// Finally, go to OctopusSDKProvider and uncomment the function that matches your community configuration in `initializeSDK`.

OCTOPUS_API_KEY = YOUR_API_KEY
CLIENT_USER_TOKEN_SECRET = YOUR_CLIENT_USER_TOKEN_SECRET

// Optional, internal builds only: the `owner/name` GitHub repository that Settings › Send feedback opens a
// pre-filled issue in. Left unset, the row is hidden. Never a public repository: the issue body carries the
// last 50 Debug console lines.
// OCTOPUS_FEEDBACK_REPO = owner/name
// Optional: YES launches the sample without the glass effect on iOS 26 and later, to check the SDK's rendering
// in an app that opted out of it. Reinstall the app after changing it.
// OCTOPUS_DESIGN_REQUIRES_COMPATIBILITY = YES
